msgstr "Minigame Test Room"

msgid "MENU_MINIGAMES_HINT"
msgstr "Pick a minigame and a mode to jump straight in. You are Player 1, the rest are bots. Press Try on the info screen to practise."

msgid "EVENT_LUCKY_DRAW"
msgstr "Lucky Draw"

msgid "EVENT_LUCKY_DRAW_TEXT"
msgstr "Mayor Pixel draws a name from his hat: {player} wins {amount} cookies!"

msgid "EVENT_COOKIE_TAX"
msgstr "Cookie Tax"

msgid "EVENT_COOKIE_TAX_TEXT"
