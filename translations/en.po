msgid "CONTEXT_WINNER_ANNOUNCEMENT"
msgstr ""
"I know all of you were fighting hard to win, but now the game is over and we "
"need a winner. And this winner is…"

msgid "CONTEXT_WINNER_REVEAL_ONE_PLAYER"
