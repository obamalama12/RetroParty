msgid "MINIGAME_NAME"
msgstr "Haunted Dreams"

msgid "MINIGAME_DESCRIPTION"
msgstr "Protect the child's bed from ghosts for 45 seconds. Every ghost that reaches the bed costs it one of its 6 health (the boss costs two). Bump into ghosts to push them back and defeat them!\nFast ghosts, tough ghosts and a boss ghost attack. Orbs banish or freeze ghosts!"

msgid "MINIGAME_ACTION_UP"
msgstr "Move Up"

msgid "MINIGAME_ACTION_DOWN"
msgstr "Move Down"

msgid "MINIGAME_ACTION_LEFT"
msgstr "Move Left"

msgid "MINIGAME_ACTION_RIGHT"
msgstr "Move Right"

msgid "HAUNTED_DREAMS_FLASH"
msgstr "LIGHT FLASH!"

msgid "HAUNTED_DREAMS_FREEZE"
msgstr "GHOSTS FROZEN!"

msgid "HAUNTED_DREAMS_BOSS"
msgstr "BOSS GHOST!"

msgid "HAUNTED_DREAMS_BOSS_DEFEATED"
msgstr "BOSS DEFEATED!"
