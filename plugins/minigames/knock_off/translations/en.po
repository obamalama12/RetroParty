msgid "MINIGAME_NAME"
msgstr "Knock Off"

msgid "MINIGAME_DESCRIPTION"
msgstr ""
"Knock your opponents off the iceberg! Everybody has two lives: the first time you fall you come back on the ice.\n"
"The ice cracks and shrinks as time passes, so stay near the middle! "
"Roll through glowing orbs for a speed boost (yellow) or to become heavy and "
"hard to push (red). If it takes too long, the ice melts away completely.\n"
"Last person standing wins!"

msgid "MINIGAME_ACTION_MOVE"
msgstr "Move"

msgid "MINIGAME_ACTION_UP"
msgstr "Move Up"

msgid "MINIGAME_ACTION_DOWN"
msgstr "Move Down"

msgid "MINIGAME_ACTION_LEFT"
msgstr "Move Left"

msgid "MINIGAME_ACTION_RIGHT"
msgstr "Move Right"

msgid "KNOCK_OFF_PLAYER_WINS_MSG"
msgstr "{player} wins!"

msgid "KNOCK_OFF_TEAM_WINS_MSG"
msgstr "Team {team} wins!"

msgid "KNOCK_OFF_ICE_CRACKING"
msgstr "The ice is cracking!"

msgid "KNOCK_OFF_SUDDEN_DEATH"
msgstr "Sudden death!"

msgid "KNOCK_OFF_POWER_RUSH"
msgstr "{player}: Speed boost!"

msgid "KNOCK_OFF_POWER_HEAVY"
msgstr "{player}: Heavy!"
